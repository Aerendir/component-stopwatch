parameters:
	ignoreErrors:
		-
			message: '#^Cannot call method getEndTime\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 1
			path: src/Event.php

		-
			message: '#^Cannot call method getTime\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 1
			path: src/Event.php

		-
			message: '#^Method SerendipityHQ\\Component\\Stopwatch\\Event\:\:getEndTime\(\) should return float\|int but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: src/Event.php

		-
			message: '#^Offset \-1 does not exist on array\{\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: src/Event.php

		-
			message: '#^Method SerendipityHQ\\Component\\Stopwatch\\Properties\\Memory\:\:measure\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Properties/Memory.php

		-
			message: '#^Property SerendipityHQ\\Component\\Stopwatch\\Properties\\Memory\:\:\$endMemory \(int\|null\) does not accept mixed\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Properties/Memory.php

		-
			message: '#^Property SerendipityHQ\\Component\\Stopwatch\\Properties\\Memory\:\:\$endMemoryCurrent \(int\|null\) does not accept mixed\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Properties/Memory.php

		-
			message: '#^Property SerendipityHQ\\Component\\Stopwatch\\Properties\\Memory\:\:\$endMemoryPeak \(int\|null\) does not accept mixed\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Properties/Memory.php

		-
			message: '#^Property SerendipityHQ\\Component\\Stopwatch\\Properties\\Memory\:\:\$endMemoryPeakEmalloc \(int\|null\) does not accept mixed\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Properties/Memory.php

		-
			message: '#^Property SerendipityHQ\\Component\\Stopwatch\\Properties\\Memory\:\:\$startMemory \(int\) does not accept mixed\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Properties/Memory.php

		-
			message: '#^Property SerendipityHQ\\Component\\Stopwatch\\Properties\\Memory\:\:\$startMemoryCurrent \(int\) does not accept mixed\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Properties/Memory.php

		-
			message: '#^Property SerendipityHQ\\Component\\Stopwatch\\Properties\\Memory\:\:\$startMemoryPeak \(int\) does not accept mixed\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Properties/Memory.php

		-
			message: '#^Property SerendipityHQ\\Component\\Stopwatch\\Properties\\Memory\:\:\$startMemoryPeakEmalloc \(int\) does not accept mixed\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Properties/Memory.php

		-
			message: '#^Method SerendipityHQ\\Component\\Stopwatch\\Properties\\Origin\:\:getOriginMemory\(\) should return SerendipityHQ\\Component\\Stopwatch\\Properties\\Memory but returns int\.$#'
			identifier: return.type
			count: 1
			path: src/Properties/Origin.php

		-
			message: '#^Property SerendipityHQ\\Component\\Stopwatch\\Properties\\Origin\:\:\$originMemory \(int\) does not accept mixed\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Properties/Origin.php

		-
			message: '#^Property SerendipityHQ\\Component\\Stopwatch\\Properties\\Origin\:\:\$originMemoryCurrent \(int\) does not accept mixed\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Properties/Origin.php

		-
			message: '#^Property SerendipityHQ\\Component\\Stopwatch\\Properties\\Origin\:\:\$originMemoryPeak \(int\) does not accept mixed\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Properties/Origin.php

		-
			message: '#^Property SerendipityHQ\\Component\\Stopwatch\\Properties\\Origin\:\:\$originMemoryPeakEmalloc \(int\) does not accept mixed\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Properties/Origin.php

		-
			message: '#^Call to function is_countable\(\) with array\<SerendipityHQ\\Component\\Stopwatch\\Section\> will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Stopwatch.php

		-
			message: '#^Argument of an invalid type mixed supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 1
			path: src/Utils/Formatter.php

		-
			message: '#^Binary operation "\+" between mixed and 1 results in an error\.$#'
			identifier: binaryOp.invalid
			count: 2
			path: src/Utils/Formatter.php

		-
			message: '#^Binary operation "/" between float and mixed results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: src/Utils/Formatter.php

		-
			message: '#^Cannot access offset \(float\|int\) on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Utils/Formatter.php

		-
			message: '#^Cannot access offset 0 on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 2
			path: src/Utils/Formatter.php

		-
			message: '#^Cannot access offset 1 on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 2
			path: src/Utils/Formatter.php

		-
			message: '#^Cannot access offset 2 on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Utils/Formatter.php

		-
			message: '#^Parameter \#3 \.\.\.\$values of function sprintf expects bool\|float\|int\|string\|null, mixed given\.$#'
			identifier: argument.type
			count: 2
			path: src/Utils/Formatter.php

		-
			message: '#^Call to static method PHPUnit\\Framework\\Assert\:\:assertInstanceOf\(\) with ''SerendipityHQ\\\\Component\\\\Stopwatch\\\\Event'' and SerendipityHQ\\Component\\Stopwatch\\Event will always evaluate to true\.$#'
			identifier: staticMethod.alreadyNarrowedType
			count: 1
			path: tests/StopwatchTest.php

		-
			message: '#^Parameter \#1 \$objectOrValue of method ReflectionProperty\:\:setValue\(\) expects object\|null, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: tests/StopwatchTest.php

		-
			message: '#^Return type of call to method PHPUnit\\Framework\\MockObject\\MockBuilder\<SerendipityHQ\\Component\\Stopwatch\\Event\>\:\:getMock\(\) contains unresolvable type\.$#'
			identifier: method.unresolvableReturnType
			count: 1
			path: tests/StopwatchTest.php

